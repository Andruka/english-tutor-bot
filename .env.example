# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# OpenRouter API (https://openrouter.ai/api/v1)
OPENROUTER_API_KEY=your_openrouter_key_here

# Database
DB_PATH=data/tutor.db

# ЮKassa (Telegram Payments) — получить в BotFather после регистрации в ЮKassa
# YOOKASSA_PROVIDER_TOKEN=your_token_here

# Model
AI_MODEL=openai/gpt-4o-mini

# Voice STT (OpenRouter Whisper)
# STT_MODEL=openai/whisper-large-v3-turbo   # $0.04/hr — быстрый через Groq

# Лимиты голосовых сообщений
# MAX_VOICE_DURATION_SEC=60   # макс. длительность одного сообщения (сек)
# DAILY_BUDGET_MINUTES=30      # дневной лимит голосовых (минут)