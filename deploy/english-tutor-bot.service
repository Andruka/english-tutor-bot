[Unit]
Description=English Tutor Bot — AI Telegram bot
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/english-tutor-bot/current
EnvironmentFile=/home/deploy/english-tutor-bot/shared/.env
ExecStart=/home/deploy/english-tutor-bot/current/.venv/bin/python -m bot.main
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target